<?xml version="1.0"?>
<package format="3">
  <name>rfd_bridge</name>
  <version>0.1.0</version>
  <description>Priority-aware transport of selected ROS 2 topics over RFDesign serial radios.</description>
  <maintainer email="derin@calpardo.com">Derin Durak</maintainer>
  <license>Apache-2.0</license>
  <url type="repository">https://github.com/CALPARDO/rfd_bridge</url>
  <url type="bugtracker">https://github.com/CALPARDO/rfd_bridge/issues</url>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rosidl_runtime_py</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>python3-serial</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>std_msgs</test_depend>
  <test_depend>geometry_msgs</test_depend>
  <test_depend>sensor_msgs</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
